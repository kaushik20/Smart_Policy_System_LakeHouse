{
  "datasets": [
    {
      "name": "claims_status",
      "displayName": "Claims by Policy Type and Status",
      "config": {
        "version": "1.1",
        "source": "policysystemdatabricks.gold.claims_by_policy_type_and_status",
        "dimensions": [
          {
            "expr": "policy_type"
          },
          {
            "expr": "claim_status"
          }
        ],
        "measures": [
          {
            "name": "claim_count",
            "expr": "SUM(claim_count)"
          }
        ]
      }
    },
    {
      "name": "sales_monthly",
      "displayName": "Sales by Policy Type and Month",
      "config": {
        "version": "1.1",
        "source": "policysystemdatabricks.gold.sales_by_policy_type_and_month",
        "dimensions": [
          {
            "expr": "policy_type"
          },
          {
            "expr": "sales_month"
          }
        ],
        "measures": [
          {
            "name": "policies_sold",
            "expr": "SUM(policies_sold)"
          },
          {
            "name": "total_premium",
            "expr": "SUM(total_premium)",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "abbreviation": "compact"
            }
          }
        ]
      }
    },
    {
      "name": "claim_analysis",
      "displayName": "Claim Analysis by Policy Type",
      "config": {
        "version": "1.1",
        "source": "policysystemdatabricks.gold.claim_analysis_by_policy_type",
        "dimensions": [
          {
            "expr": "policy_type"
          }
        ],
        "measures": [
          {
            "name": "total_policies",
            "expr": "SUM(policies)"
          },
          {
            "name": "total_premium",
            "expr": "SUM(total_premium)",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "abbreviation": "compact",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "total_claims_paid",
            "expr": "SUM(total_claim_amount)",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "abbreviation": "compact",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "loss_ratio",
            "expr": "SUM(total_claim_amount) / SUM(total_premium)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "claim_count",
            "expr": "SUM(claim_count)"
          },
          {
            "name": "avg_claim_amount",
            "expr": "SUM(total_claim_amount) / SUM(claim_count)",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "min_claim_amount",
            "expr": "MIN(min_claim_amount)",
            "format": {
              "type": "currency",
              "currencyCode": "USD"
            }
          },
          {
            "name": "max_claim_amount",
            "expr": "MAX(max_claim_amount)",
            "format": {
              "type": "currency",
              "currencyCode": "USD"
            }
          }
        ]
      }
    },
    {
      "name": "7c6ce492",
      "displayName": "Claims Detail",
      "queryLines": [
        "   SELECT p.policy_type, c.claim_id, c.claim_amount, c.claim_status\r\n",
        "   FROM policysystemdatabricks.silver.claim c\r\n",
        "   JOIN policysystemdatabricks.silver.policydata p ON c.policy_id = p.policy_id"
      ]
    }
  ],
